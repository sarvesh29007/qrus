# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrus
# Pool sizing
DB_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-64-random-bytes-minimum
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated origins. "*" is only allowed outside production.
CORS_ORIGINS=http://localhost:5173
# IANA timezone the clinic operates in (slot wall-clock times)
APP_TZ=UTC

# --- Booking policy ---------------------------------------------------------
SLOT_MIN_LEAD_MINUTES=30       # cannot book closer than this to now
SLOT_MAX_HORIZON_DAYS=60       # cannot book further out than this
WAITLIST_ENTRY_TTL_DAYS=7      # auto-expire stale waitlist entries
WAITLIST_SWEEP_INTERVAL_MINUTES=15
AUDIT_STRICT=false             # true => a failed audit write fails the action

# --- Chatbot / LLM (optional) ----------------------------------------------
# Leave LLM_API_KEY empty to run the chatbot on the built-in rule classifier:
# FAQ, queue status, scheduling and intake all work without any provider.
LLM_PROVIDER=openai            # openai | gemini
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=8000
# LLM_API_KEY is set per environment, never committed.
